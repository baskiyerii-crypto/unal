# ===================================================================
# MenakYapı Project Environment Variables Template (.env.example)
# ===================================================================

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# -------------------------------------------------------------------
# Database Connection URL (Standard PostgreSQL connection - Zero Lock-in)
POSTGRES_USER=menak_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=menak_db
DATABASE_URI=postgres://menak_user:your_secure_postgres_password_here@postgres:5432/menak_db

# -------------------------------------------------------------------
# 2. NEXT.JS & PAYLOAD CMS CONFIGURATION
# -------------------------------------------------------------------
NODE_ENV=development
NEXTAUTH_URL=https://menakyapi.com.tr
NEXT_PUBLIC_SITE_URL=https://menakyapi.com.tr
PAYLOAD_SECRET=your_super_secret_payload_jwt_key_min_32_chars

# Domain name for production (Coolify Domains UI + app absolute URLs)
DOMAIN_NAME=menakyapi.com.tr

# -------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL CONFIGURATION (Nodemailer SMTP)
# -------------------------------------------------------------------
# Standard SMTP Settings (Decoupled from email provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=menakyapi@gmail.com
SMTP_PASS=your_app_specific_password_here
NOTIFICATION_EMAIL_RECIPIENT=menakyapi@gmail.com

# -------------------------------------------------------------------
# 4. ANALYTICS & TRACKING (Optional Local Defaults)
# -------------------------------------------------------------------
# Note: These can also be configured dynamically via Payload Admin -> site-settings
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
